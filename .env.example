# Copy this file to .env and fill in real values for anything you deploy.
# For local dev, the default below already matches the PGlite server that
# `npm run dev` starts for you (see `db-server:file` in package.json).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# TouchSwap game (src/pages/game)
FIRESTORE_EMULATOR_HOST=localhost:8080
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-file.json # production Firebase, not needed locally
# BOT_TOKEN= # Telegram bot token, only needed for /api/validateHash
# NEXT_PUBLIC_BACKEND_URL= # only if the game talks to an external API instead of its own /api routes
