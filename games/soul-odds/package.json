{
  "name": "soulodds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "./start-dev.sh",
    "start:dev": "./start-dev.sh",
    "start:prod": "./start-prod.sh",
    "dev:next": "next dev",
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "build": "run-s db:migrate build:next",
    "build:next": "next build",
    "start:next": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "dotenv -e .env -- tsx src/services/seedDb.ts",
    "db:seed:cliopatria": "dotenv -e .env -- tsx src/services/seedCliopatria.ts",
    "db:seed:sin-catalog": "dotenv -e .env -- tsx src/services/seedSinCatalog.ts",
    "db:seed:sin-catalog:prod": "dotenv -e .env -- tsx src/services/seedSinCatalog.ts --prod",
    "db:seed:cliopatria:zip": "dotenv -e .env -- tsx src/scripts/seed-cliopatria-from-zip.ts",
    "game:socket-server": "tsx src/server/index.ts",
    "check:types": "tsc --noEmit --pretty",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check"
  },
  "dependencies": {
    "@arcjet/next": "1.10.0",
    "@chain/casino-sdk": "file:../..",
    "@chain/soul-odds-engine": "file:../../soul-odds-engine",
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@kenshi.io/node-ecvrf": "^0.10.1",
    "@logtape/logtape": "2.3.1",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^2.4.0",
    "@number-flow/react": "^0.6.2",
    "@sentry/nextjs": "10.70.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "axios": "^1.20.0",
    "countdown": "^2.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "eruda": "^3.4.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^13.3.0",
    "gsap": "^3.15.0",
    "next": "16.3.1",
    "next-intl": "4.13.4",
    "numeral": "^2.0.6",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-canvas-confetti": "^2.0.7",
    "react-countdown": "^2.3.6",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "react-use": "^17.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "translation-resilience": "^0.4.0",
    "typesaurus": "^10.7.0",
    "viem": "^2.52.2",
    "zod": "4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@electric-sql/pglite-socket": "0.2.8",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.62.1",
    "@spotlightjs/spotlight": "4.11.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "25.9.5",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "firebase-tools": "^15.30.1",
    "hardhat": "^3.12.0",
    "npm-run-all": "4.1.5",
    "rimraf": "6.1.3",
    "solc": "^0.8.30",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}