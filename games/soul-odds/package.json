{
  "name": "soulodds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "./start-dev.sh",
    "start:dev": "./start-dev.sh",
    "start:prod": "./start-prod.sh",
    "dev:next": "next dev",
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "build": "run-s db:migrate build:next",
    "build:next": "next build",
    "start:next": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "dotenv -e .env -- tsx src/services/seedDb.ts",
    "db:seed:cliopatria": "dotenv -e .env -- tsx src/services/seedCliopatria.ts",
    "db:seed:sin-catalog": "dotenv -e .env -- tsx src/services/seedSinCatalog.ts",
    "db:seed:sin-catalog:prod": "dotenv -e .env -- tsx src/services/seedSinCatalog.ts --prod",
    "db:seed:cliopatria:zip": "dotenv -e .env -- tsx src/scripts/seed-cliopatria-from-zip.ts",
    "game:socket-server": "tsx src/server/index.ts",
    "check:types": "tsc --noEmit --pretty",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check"
  },
  "dependencies": {
    "@arcjet/next": "1.10.0",
    "@chain/casino-sdk": "file:../..",
    "@chain/soul-odds-engine": "file:../../soul-odds-engine",
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@number-flow/react": "^0.6.2",
    "@sentry/nextjs": "10.70.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "eruda": "^3.4.3",
    "framer-motion": "^13.3.0",
    "gsap": "^3.15.0",
    "next": "16.3.1",
    "next-intl": "4.13.4",
    "numeral": "^2.0.6",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-canvas-confetti": "^2.0.7",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "translation-resilience": "^0.4.0",
    "viem": "^2.52.2",
    "zod": "4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@electric-sql/pglite": "0.5.5",
    "@playwright/test": "1.62.1",
    "@spotlightjs/spotlight": "4.11.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "25.9.5",
    "@types/numeral": "^2.0.5",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "hardhat": "^3.12.0",
    "knip": "^6.38.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vite": "^8.3.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
