{
  "name": "next-js-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:next": "next dev",
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "build": "run-s db:migrate build:next",
    "build:next": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "dotenv -e .env -- tsx src/services/seedDb.ts",
    "game:socket-server": "tsx src/server/index.ts",
    "blockchain:node": "tsx blockchain/local-node/index.ts",
    "blockchain:verify-network": "tsx blockchain/verify-network/cli.ts",
    "blockchain:local": "run-s blockchain:node",
    "blockchain:compile-contracts": "node blockchain/scripts/compile-contracts.mjs",
    "check:types": "tsc --noEmit --pretty",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check"
  },
  "dependencies": {
    "@arcjet/next": "1.10.0",
    "@farcaster/frame-core": "^0.5.0",
    "@farcaster/frame-sdk": "^0.2.0",
    "@grammyjs/web-app": "^1.3.0",
    "@heroicons/react": "^2.2.0",
    "@kenshi.io/node-ecvrf": "^0.10.1",
    "@logtape/logtape": "2.3.1",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.1",
    "@sentry/nextjs": "10.70.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tma.js/sdk-react": "^3.0.23",
    "@tonconnect/ui-react": "^3.0.2",
    "@tronweb3/tronwallet-abstract-adapter": "^1.3.0",
    "@tronweb3/tronwallet-adapter-bitkeep": "^1.1.0",
    "@tronweb3/tronwallet-adapter-ledger": "^1.1.15",
    "@tronweb3/tronwallet-adapter-tokenpocket": "^1.2.0",
    "@tronweb3/tronwallet-adapters": "^1.3.3",
    "@tronweb3/tronwallet-adapter-react-hooks": "^1.1.14",
    "@tronweb3/tronwallet-adapter-react-ui": "^1.2.2",
    "@tronweb3/walletconnect-tron": "^4.0.3",
    "axios": "^1.20.0",
    "countdown": "^2.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^13.3.0",
    "next": "16.3.1",
    "next-intl": "4.13.4",
    "numeral": "^2.0.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-countdown": "^2.3.6",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-use": "^17.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "telegram-webapps-types": "^1.0.5",
    "typesaurus": "^10.7.0",
    "viem": "^2.52.2",
