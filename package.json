    "hardhat": "^3.12.0",
    "npm-run-all": "4.1.5",
    "rimraf": "6.1.3",
    "solc": "^0.8.30",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vitest": "4.1.10"
