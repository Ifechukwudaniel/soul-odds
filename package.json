{
  "name": "next-js-boilerplate",
  "author": "Ixartz (https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "postinstall": "node blockchain/scripts/fix-hardhat-zod.mjs",
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server -m 100 --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server -m 100 --run 'npm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build",
    "game:socket-server": "tsx src/server/index.ts",
    "game:emulators": "firebase emulators:start --only firestore",
    "blockchain:node": "tsx blockchain/local-node/index.ts",
    "blockchain:verify-network": "tsx blockchain/verify-network/cli.ts",
    "blockchain:local": "run-s blockchain:node",
    "blockchain:compile-contracts": "node blockchain/scripts/compile-contracts.mjs"
  },
  "dependencies": {
    "@arcjet/next": "1.10.0",
    "@farcaster/frame-core": "^0.5.0",
    "@farcaster/frame-sdk": "^0.2.0",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/rubik": "^5.2.8",
    "@grammyjs/web-app": "^1.3.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "5.9.1",
    "@kenshi.io/node-ecvrf": "^0.10.1",
    "@logtape/logtape": "2.3.1",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@sentry/nextjs": "10.70.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tma.js/sdk-react": "^3.0.23",
    "@tonconnect/ui-react": "^3.0.2",
    "@tronweb3/tronwallet-abstract-adapter": "^1.3.0",
    "@tronweb3/tronwallet-adapter-bitkeep": "^1.3.0",
    "@tronweb3/tronwallet-adapter-ledger": "^1.1.15",
    "@tronweb3/tronwallet-adapter-react-hooks": "^1.1.14",
    "@tronweb3/tronwallet-adapter-react-ui": "^1.2.2",
    "@tronweb3/tronwallet-adapter-tokenpocket": "^1.2.0",
    "@tronweb3/tronwallet-adapters": "^1.3.3",
    "@tronweb3/walletconnect-tron": "^4.0.3",
    "@types/socket.io": "^3.0.2",
    "@types/telegram-web-app": "^10.1.0",
    "axios": "^1.20.0",
    "countdown": "^2.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "eruda": "^3.4.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^13.3.0",
    "next": "16.3.1",
    "next-intl": "4.13.4",
    "numeral": "^2.0.6",
    "penpal": "^7.0.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-canvas-confetti": "^2.0.7",
    "react-countdown": "^2.3.6",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-use": "^17.6.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "telegram-webapps-types": "^1.0.5",
    "translation-resilience": "0.3.0",
    "typesaurus": "^10.7.0",
    "viem": "^2.52.2",
    "zod": "4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "0.14.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/prompt-cli": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@electric-sql/pglite": "0.5.5",
    "@electric-sql/pglite-socket": "0.2.8",
    "@faker-js/faker": "10.6.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.62.1",
    "@spotlightjs/spotlight": "4.11.8",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/nextjs-vite": "10.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/numeral": "^2.0.5",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "firebase-tools": "^15.30.1",
    "hardhat": "^3.12.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "solc": "^0.8.30",
    "storybook": "10.5.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vite": "8.3.0",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
